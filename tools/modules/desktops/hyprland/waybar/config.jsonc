// Armbian Waybar for Hyprland.
{
	"layer": "top",
	"position": "top",
	"height": 26,
	"spacing": 0,
	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["tray", "bluetooth", "network", "pulseaudio", "cpu", "battery"],

	"hyprland/workspaces": {
		"format": "{name}",
		"on-click": "activate",
		"persistent-workspaces": {
			"*": 5
		}
	},
	"clock": {
		"format": "{:%A %H:%M}",
		"format-alt": "{:%d %B %Y}",
		"tooltip-format": "<tt>{calendar}</tt>"
	},
	"tray": {
		"icon-size": 14,
		"spacing": 10
	},
	// Glyphs in Font Awesome 4.7 and later.
	"bluetooth": {
		"format": "",
		"format-disabled": "",
		"format-off": "",
		"tooltip-format": "{controller_alias} {status}",
		"on-click": "blueman-manager"
	},
	"network": {
		"format-wifi": "",
		"format-ethernet": "",
		"format-disconnected": "",
		"tooltip-format-wifi": "{essid} {signalStrength}%  {ipaddr}",
		"tooltip-format-ethernet": "{ifname} {ipaddr}/{cidr}",
		"on-click": "nm-connection-editor"
	},
	"pulseaudio": {
		"format": "{icon}",
		"format-muted": "",
		"format-icons": ["", "", ""],
		"tooltip-format": "Volume {volume}%",
		"on-click": "pavucontrol"
	},
	"cpu": {
		"format": "",
		"tooltip-format": "CPU {usage}%",
		"interval": 5
	},
	"battery": {
		"format": "{icon}",
		"format-icons": ["", "", "", "", ""],
		"tooltip-format": "Battery {capacity}%  {timeTo}"
	}
}
